<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Condition="'$(ProjectIsInDocs)' == 'true'">
    <PackageVersion Include="Markdig" Version="1.1.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Gateway" Version="11.0.0" />
  </ItemGroup>
  
  <ItemGroup Condition="'$(ProjectIsInSrc)' == 'true'">
    <PackageVersion Include="Microsoft.AspNetCore.Components" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageVersion Include="Microsoft.JSInterop" Version="11.0.0" />
    <PackageVersion Update="Microsoft.*" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />

    <PackageVersion Include="JsBind.Net.Extensions.DependencyInjection" Version="4.0.1" />
    <PackageVersion Include="WebExtensions.Net.Extensions.DependencyInjection" Version="7.0.0" />
    <PackageVersion Include="Blazor.BrowserExtension.Build" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(ProjectIsInTest)' == 'true'">
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Gateway" Version="11.0.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Blazor.BrowserExtension.Build" Version="5.1.0" />
  </ItemGroup>

</Project>